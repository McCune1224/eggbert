[ext_resource type="Script" path="res://resources/cutscene/CutsceneResource.cs" id="3_xvfxp"]

[sub_resource type="Resource" id="Resource_not_settled"]
script = ExtResource("2_rgxoq")
Type = 2
FlagKey = "intake_settled"

[sub_resource type="Resource" id="Resource_intro"]
script = ExtResource("1_ttrbs")
Condition = SubResource("Resource_not_settled")
DialogLines = PackedStringArray("Frank: Hey, bunkmate! Name's Frank. Welcome to Eggs Isle.", "Frank: Layout: Block C's past the north door. Guard room's got the keys. Block A's collapsed, Block B's the noisy ones. Cells are through the west hall.", "Frank: Before they let us bunk up, we gotta pass intake. Officer's been on about some towels.", "Frank: Do me a favor — find the towels somewhere in this block, and we'll get you settled into your cell. Blend in. Find out what you can.")
TargetNode = NodePath("")
AnimationNode = NodePath("")
SetFlagValue = null

[sub_resource type="Resource" id="Resource_settled"]
script = ExtResource("2_rgxoq")
Type = 1
FlagKey = "intake_settled"

[sub_resource type="Resource" id="Resource_handoff"]
script = ExtResource("1_ttrbs")
Condition = SubResource("Resource_settled")
DialogLines = PackedStringArray("Frank: Good work. Grab your Cell Key — I'll cover you.", "Frank: Get some rest. First day on the Isle is always the longest.")
TargetNode = NodePath("")
AnimationNode = NodePath("")
SetFlagValue = null

[resource]
script = ExtResource("3_xvfxp")
Steps = Array[ExtResource("1_ttrbs")]([SubResource("Resource_intro"), SubResource("Resource_handoff")])
