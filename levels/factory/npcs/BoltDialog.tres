Text = "(Leave)"

[sub_resource type="Resource" id="Resource_qijds"]
script = ExtResource("1_7cnim")
Id = "opt1"
SpeakerName = "Bolt"
Lines = PackedStringArray("*Bolt squints* Seen footprints shaped like eggs. Weirdest thing.", "Management says ignore it. I say keep your head down.")
Responses = [SubResource("Resource_aurd0")]

[resource]
