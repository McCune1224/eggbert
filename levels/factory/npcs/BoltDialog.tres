[sub_resource type="Resource" id="Resource_wotfl"]
script = ExtResource("1_7cnim")
Id = "opt0"
SpeakerName = "Bolt"
Lines = PackedStringArray("Step on one and you\'ll slide. Sprint to push against the flow.", "Don\'t stand on the belt if you need to stop fast.")
Responses = [SubResource("Resource_7m5sv")]

[sub_resource type="Resource" id="Resource_aurd0"]
