[gd_resource type="Resource" format=3 uid="uid://gtgfinale01"]

[ext_resource type="Script" path="res://resources/cutscene/cutscene_resource.gd" id="1_cs"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_condition.gd" id="2_cond"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_step.gd" id="3_step"]

[sub_resource type="Resource" id="SubResource_cond_leader_beaten"]
script = ExtResource("2_cond")
type = 1
flag_key = "beat_leader"

[sub_resource type="Resource" id="SubResource_step_1"]
script = ExtResource("3_step")
type = 10
condition = SubResource("SubResource_cond_leader_beaten")

[sub_resource type="Resource" id="SubResource_step_2"]
script = ExtResource("3_step")
type = 0
condition = SubResource("SubResource_cond_leader_beaten")
dialog_lines = ["The Leader falls. The shrine sand churns. The sky over the beach splits.", "A CRACK. Then a hum. Then a smell — butter, and burning."]

[sub_resource type="Resource" id="SubResource_step_3"]
script = ExtResource("3_step")
type = 0
condition = SubResource("SubResource_cond_leader_beaten")
dialog_lines = ["The Great Toast God rises from the sea, golden and vast and absolutely indifferent.", "GTG: '...hm. Someone summoned me. For breakfast?'", "GTG: 'Cultists. Always with the cultists. They never read the fine print.'"]

[sub_resource type="Resource" id="SubResource_step_4"]
script = ExtResource("3_step")
type = 0
condition = SubResource("SubResource_cond_leader_beaten")
dialog_lines = ["GTG: 'You. Little egg. You have a pure soul. I can see it from here.'", "GTG: 'The cult wanted me to scrape the world clean. I don't want to. I never wanted to.'", "GTG: 'I just want to be left alone with my butter, frankly.'"]

[sub_resource type="Resource" id="SubResource_step_5"]
script = ExtResource("3_step")
type = 7
condition = SubResource("SubResource_cond_leader_beaten")
set_flag_key = "gtg_summoned"
set_flag_value = true

[sub_resource type="Resource" id="SubResource_step_6"]
script = ExtResource("3_step")
type = 0
condition = SubResource("SubResource_cond_leader_beaten")
dialog_lines = ["GTG: 'Go home, Eggbert. You've earned it. I'll put things right here.'", "GTG: 'Tell the cult I said hi. Tell them I said: go eat a normal lunch.'"]

[sub_resource type="Resource" id="SubResource_step_7"]
script = ExtResource("3_step")
type = 8
condition = SubResource("SubResource_cond_leader_beaten")
fade_direction = "out"

[sub_resource type="Resource" id="SubResource_step_8"]
script = ExtResource("3_step")
type = 11
condition = SubResource("SubResource_cond_leader_beaten")

[sub_resource type="Resource" id="SubResource_step_9"]
script = ExtResource("3_step")
type = 12
condition = SubResource("SubResource_cond_leader_beaten")

[resource]
script = ExtResource("1_cs")
steps = Array[Resource]([SubResource("SubResource_step_1"), SubResource("SubResource_step_2"), SubResource("SubResource_step_3"), SubResource("SubResource_step_4"), SubResource("SubResource_step_5"), SubResource("SubResource_step_6"), SubResource("SubResource_step_7"), SubResource("SubResource_step_8"), SubResource("SubResource_step_9")])
